# Sample configuration values only. Never commit a real .env file.
# The server reads these from the environment (it does not read this file by itself).
# For a normal local run you do not need any of them: the defaults work.

PORT=3000
MAX_UPLOAD_MB=20
AUTH_RATE_LIMIT=30

# Optional. If empty, a random secret is created inside the data folder on first start.
# SESSION_SECRET=

# Optional. Where the database and uploads are stored (default: ./data).
# DATA_DIR=./data

# Only on a hosted HTTPS site (turns on Secure cookies).
# NODE_ENV=production
